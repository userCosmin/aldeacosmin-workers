---
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import BlurFadeText from '../motion/BlurFadeText';
import { cfImage, cfSrcSet } from '../../lib/image';
import type { Crumb } from '../../lib/schema';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  crumbs: Crumb[];
  image?: string;
  imageAlt?: string;
  /** Taller hero for detail pages with a cover image. */
  tall?: boolean;
}

const { eyebrow, title, subtitle, crumbs, image, imageAlt = '', tall = false } = Astro.props;
---

<section
  class:list={[
    'grain relative isolate overflow-hidden',
    image ? (tall ? 'min-h-[78svh] pt-36 pb-14 md:pt-44' : 'min-h-[60svh] pt-36 pb-14 md:pt-44') : 'pt-32 pb-12 md:pt-44 md:pb-16',
    'flex items-end',
  ]}
>
  {
    image ? (
      <>
        <img
          src={cfImage(image, { width: 1600 })}
          srcset={cfSrcSet(image, [640, 960, 1280, 1600, 2000])}
          sizes="100vw"
          alt={imageAlt}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-b from-background/80 via-background/45 to-background" />
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,transparent_30%,var(--background)_95%)] opacity-70" />
      </>
    ) : (
      <div class="aurora -z-10 opacity-35">
        <span />
        <span />
        <span />
      </div>
    )
  }
  <div class="container-x relative">
    <Breadcrumbs crumbs={crumbs} class="fade-up mb-6" />
    <p class="eyebrow fade-up mb-4" style="--d:0.05s">{eyebrow}</p>
    <BlurFadeText
      as="h1"
      text={title}
      className="max-w-4xl text-[clamp(2.4rem,1.6rem+4vw,5rem)] leading-[1.02] font-medium"
      delay={0.1}
    />
    {subtitle && <p class="fade-up mt-6 max-w-2xl text-lg text-muted md:text-xl" style="--d:0.45s">{subtitle}</p>}
    <slot />
  </div>
</section>
