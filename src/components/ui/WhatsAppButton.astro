---
import { WHATSAPP } from '../../data/site';
import { trackAttrs } from '../../lib/analytics';
import WhatsAppIcon from './WhatsAppIcon.astro';
---

<a
  href={WHATSAPP.url}
  target="_blank"
  rel="noopener"
  aria-label={`Scrie-mi pe WhatsApp la ${WHATSAPP.display} (se deschide într-o filă nouă)`}
  class="group fixed right-4 bottom-[calc(max(env(safe-area-inset-bottom),0.75rem)+4.75rem)] z-[65] flex h-14 items-center gap-0 rounded-full bg-[#25d366] p-[0.875rem] text-[#063b1f] shadow-[0_12px_32px_-8px_rgb(37_211_102/0.65)] transition-[gap,padding,transform] duration-300 hover:-translate-y-0.5 hover:gap-2.5 hover:pr-5 focus-visible:gap-2.5 focus-visible:pr-5 md:right-6 md:bottom-6"
  {...trackAttrs('whatsapp_click', { location: 'floating-button' })}
>
  <span aria-hidden="true" class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25d366] opacity-25 [animation-duration:2.4s]"></span>
  <WhatsAppIcon class="size-7 shrink-0" />
  <span
    class="max-w-0 overflow-hidden text-sm font-semibold whitespace-nowrap transition-[max-width] duration-300 group-hover:max-w-48 group-focus-visible:max-w-48"
  >
    Scrie-mi pe WhatsApp
  </span>
</a>
