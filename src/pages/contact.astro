---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SocialCards from '../components/ui/SocialCards.astro';
import { EMAIL, SITE } from '../data/site';
import { trackAttrs } from '../lib/analytics';
import { PERSON_ID, type Crumb } from '../lib/schema';

const crumbs: Crumb[] = [
  { name: 'Acasă', href: '/' },
  { name: 'Contact', href: '/contact' },
];
const title = 'Contact — Trasee, ture și întrebări despre munte';
const description =
  'Scrie-i lui Aldea Cosmin din Alba Iulia pe email pentru întrebări despre trasee montane, condițiile de pe creste sau o tură împreună.';

const contactNode = {
  '@type': 'ContactPage',
  '@id': `${SITE.url}/contact#contact`,
  url: `${SITE.url}/contact`,
  name: title,
  inLanguage: 'ro-RO',
  about: { '@id': PERSON_ID },
};
---

<BaseLayout title={title} description={description} breadcrumbs={crumbs} schema={[contactNode]}>
  <PageHero
    eyebrow="Contact"
    title="Ne vedem pe munte."
    subtitle="Ai o întrebare despre un traseu, condițiile de pe creastă sau vrei să urcăm împreună? Scrie-mi — îți răspund cu drag."
    crumbs={crumbs}
  />

  <section aria-label="Cum mă poți contacta" class="container-x flex flex-wrap gap-3 pt-4">
    <a
      href={`mailto:${EMAIL}`}
      class="inline-flex h-14 items-center gap-2 rounded-full bg-accent px-7 font-semibold text-accent-ink transition-colors hover:bg-accent-strong"
      {...trackAttrs('email_click', { location: 'contact-hero' })}
    >
      {EMAIL} <span aria-hidden="true">→</span>
    </a>
  </section>

  <section aria-labelledby="social-title" class="container-x pt-24">
    <SectionHeading id="social-title" eyebrow="Profiluri oficiale" title="Urmărește traseele în timp real" />
    <SocialCards location="contact" />
  </section>
</BaseLayout>
